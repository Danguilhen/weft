{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weft.network/schemas/node-0.1.json",
  "title": "Weft node descriptor",
  "description": "Signed description of a Weft node, served at /.well-known/weft. Discovery is not trust.",
  "type": "object",
  "required": ["version", "nodeId", "publicUrl", "keys"],
  "properties": {
    "version": {
      "type": "string",
      "const": "weft-node/0.1"
    },
    "nodeId": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "publicUrl": {
      "type": "string",
      "format": "uri"
    },
    "actor": {
      "type": "string",
      "format": "uri"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["keyId", "alg", "publicKey"],
        "properties": {
          "keyId": {
            "type": "string",
            "format": "uri"
          },
          "alg": {
            "type": "string",
            "const": "Ed25519"
          },
          "publicKey": {
            "type": "string",
            "description": "base64url raw public key"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "revokedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "api": {
          "type": "array",
          "items": { "type": "string" }
        },
        "media": {
          "type": "array",
          "items": { "type": "string" }
        },
        "federation": {
          "type": ["string", "null"]
        },
        "replication": {
          "type": "boolean"
        },
        "search": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxUploadBytes": { "type": "integer", "minimum": 1 },
        "maxPixels": { "type": "integer", "minimum": 1 },
        "maxFrames": { "type": "integer", "minimum": 1 },
        "maxReplicaBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "policyUrl": {
      "type": "string",
      "format": "uri"
    },
    "contact": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "required": ["alg", "keyId", "value"],
      "properties": {
        "alg": {
          "type": "string",
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "format": "uri"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
